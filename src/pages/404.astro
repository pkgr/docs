---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/Logo.astro';
---

<BaseLayout title="Page not found" description="The requested Packager.io documentation page could not be found." noindex>
	<header class="not-found-header">
		<a href="/" aria-label="Packager.io documentation home"><Logo /></a>
	</header>
	<main id="main-content" class="not-found">
		<div class="package-mark" aria-hidden="true">404</div>
		<p class="eyebrow">Package not found</p>
		<h1>This page missed the repository.</h1>
		<p>The guide may have moved, or the URL may be incomplete.</p>
		<div class="actions">
			<a class="primary" href="/">Browse the documentation</a>
			<a href="mailto:support@packager.io">Ask support</a>
		</div>
	</main>
</BaseLayout>

<style>
	.not-found-header { height: 4rem; display: flex; align-items: center; padding: 0 1.25rem; background: var(--paper); border-bottom: 1px solid var(--border-default); }
	.not-found { min-height: calc(100vh - 4rem); display: grid; align-content: center; justify-items: start; max-width: 48rem; margin: auto; padding: 4rem 1.5rem; }
	.package-mark { display: grid; width: 5rem; height: 5rem; place-items: center; margin-bottom: 1.5rem; color: var(--paper); background: var(--clay-500); border-radius: var(--radius-lg); box-shadow: 0.8rem 0.8rem 0 var(--sage-100); font: 800 1.1rem var(--font-mono); transform: rotate(-3deg); }
	.eyebrow { margin: 0 0 0.75rem; color: var(--clay-600); font: 700 0.72rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
	h1 { max-width: 42rem; margin: 0; color: var(--text-strong); font: 800 clamp(2.6rem, 8vw, 5rem)/0.98 var(--font-display); letter-spacing: -0.05em; text-wrap: balance; }
	.not-found > p:not(.eyebrow) { color: var(--text-muted); font-size: 1.1rem; }
	.actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.5rem; }
	.actions a { padding: 0.65rem 0.9rem; color: var(--text-strong); background: var(--paper); border: 1px solid var(--border-default); border-radius: var(--radius-sm); font-weight: 700; }
	.actions .primary { color: var(--paper); background: var(--clay-600); border-color: var(--clay-600); }
</style>
